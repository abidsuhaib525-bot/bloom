{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "drift",
	"version": "3.9.2",
	"identifier": "com.drift.desktop",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "drift",
				"width": 1920,
				"height": 420,
				"x": 0,
				"y": 0,
				"decorations": false,
				"transparent": true,
				"resizable": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": true,
				"visibleOnAllWorkspaces": true,
				"focus": false,
				"skipTaskbar": true,
				"shadow": false,
				"visible": false,
				"dragDropEnabled": false
			},
			{
				"label": "settings",
				"title": "Drift Settings",
				"url": "settings.html",
				"width": 620,
				"height": 480,
				"decorations": false,
				"transparent": true,
				"resizable": true,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": false,
				"visibleOnAllWorkspaces": false,
				"focus": true,
				"skipTaskbar": true,
				"shadow": true,
				"visible": false,
				"center": true
			},
			{
				"label": "overlay",
				"title": "Overlay",
				"url": "overlay.html",
				"width": 1920,
				"height": 1080,
				"x": 0,
				"y": 0,
				"decorations": false,
				"transparent": true,
				"resizable": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": true,
				"visibleOnAllWorkspaces": true,
				"focus": false,
				"skipTaskbar": true,
				"shadow": false,
				"visible": false
			},
			{
				"label": "dock",
				"title": "Drift Dock",
				"url": "dock.html",
				"width": 1920,
				"height": 600,
				"x": 0,
				"y": 480,
				"decorations": false,
				"transparent": true,
				"resizable": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": true,
				"visibleOnAllWorkspaces": true,
				"focus": false,
				"skipTaskbar": true,
				"shadow": false,
				"visible": false
			},
			{
				"label": "launcher",
				"title": "Drift Launcher",
				"url": "launcher.html",
				"width": 720,
				"height": 520,
				"decorations": false,
				"transparent": true,
				"resizable": false,
				"maximizable": false,
				"minimizable": false,
				"closable": false,
				"alwaysOnTop": true,
				"visibleOnAllWorkspaces": false,
				"focus": true,
				"skipTaskbar": true,
				"shadow": false,
				"visible": false,
				"center": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://ipapi.co http://ip-api.com https://drift.abidsuhaib525-bot.com"
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"nsis": {
				"installMode": "currentUser",
				"installerIcon": "icons/icon.ico",
				"languages": ["en-US"],
				"displayLanguageSelector": false
			}
		}
	},
	"plugins": {
		"updater": {
			"active": true,
			"endpoints": [
				"https://github.com/abidsuhaib525-bot/drift/releases/latest/download/latest.json"
			],
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQTAzNTlBRUFFODRFMDUKUldRRlR1anFtaldnUThWRExWQ2ZDVmxhNGlFREFPYWZoV1BWbGdQNUxxdHpnbzZPbGh4SWxVMk0K"
		}
	}
}
